	partition 'public fact_movie' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost", "movie_dw"),
				    public_fact_movie = Source{[Schema="public",Item="fact_movie"]}[Data]
				in
				    public_fact_movie

	annotation PBI_ResultType = Table


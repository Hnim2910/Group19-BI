          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "public fact_movie"
                    }
                  },
                  "Property": "Avg ROI"
                }
              },
              "queryRef": "public fact_movie.Avg ROI",
              "nativeQueryRef": "Avg ROI"
